# Copy this file to .env and fill in the values:  cp .env.example .env

# Your domain, without https:// (its DNS must point to this server)
DOMAIN=example.ir
# Email for the free HTTPS certificate (Let's Encrypt)
ACME_EMAIL=you@example.com

# Long random secret. Generate one with:  openssl rand -hex 32
SECRET_KEY=

# Admin panel address (do NOT use "admin"). Site will be at https://DOMAIN/<ADMIN_URL>
# The site refuses to start while this is "admin/" or still "panel-change-me/".
ADMIN_URL=panel-change-me/

# Admin login protection: after this many wrong passwords/2FA codes from one IP,
# the admin login is closed for AXES_COOLOFF_HOURS hours
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_HOURS=1
# Name shown in the authenticator app (two-step login) for this site
OTP_TOTP_ISSUER=Pichyar

# First admin user, created automatically on first start if no admin exists yet.
# The admin logs in with this mobile number + password.
DJANGO_SUPERUSER_MOBILE=09120000000
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# Number of daily database backups to keep
BACKUP_KEEP=14

# Largest product image that can be uploaded in the admin, in MB
PRODUCT_IMAGE_MAX_MB=5

# Largest card-to-card receipt image a customer can upload, in MB
RECEIPT_MAX_MB=5

# SMS login codes: how many codes per hour for one mobile number / one IP address
OTP_MAX_PER_MOBILE_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=15

# Where the "leave" button of the 18+ gate sends visitors
AGE_GATE_EXIT_URL=https://www.google.com/

# HTTPS strict mode duration in seconds (30 days)
SECURE_HSTS_SECONDS=2592000

# Leave empty to use SQLite. To switch to PostgreSQL later, set e.g.:
# DATABASE_URL=postgres://user:password@db:5432/pichyar
DATABASE_URL=

# --- Optional overrides (the defaults are fine for a normal install) ---
# Never set DEBUG=True on the live site
# DEBUG=False
# Comma-separated host names. Defaults to DOMAIN.
# ALLOWED_HOSTS=example.ir,www.example.ir
# Trust the X-Forwarded-For header from the reverse proxy (on by default in production)
# USE_X_FORWARDED_FOR=True
# Where the database, uploads and logs are kept, and where backups go
# DATA_DIR=/app/var
# BACKUP_DIR=/app/var/backups
# Test database file name (lets several test runs work side by side)
# TEST_DB_NAME=test.sqlite3
