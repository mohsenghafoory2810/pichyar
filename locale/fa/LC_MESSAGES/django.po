# ---- Django admin (django.contrib.admin) ----

msgid "Select this object for an action - {}"
msgstr "انتخاب این مورد برای انجام اقدام - {}"

msgid "Breadcrumbs"
msgstr "مسیر صفحه"

msgid "Model name"
msgstr "نام بخش"

msgid "Please correct the error below."
msgid_plural "Please correct the errors below."
msgstr[0] "لطفاً خطای زیر را اصلاح کنید."
msgstr[1] "لطفاً خطاهای زیر را اصلاح کنید."

msgid "This action will <strong>enable</strong> password-based authentication for this user."
msgstr "این کار ورود با گذرواژه را برای این کاربر <strong>فعال</strong> می‌کند."

msgid "entry"
msgid_plural "entries"
msgstr[0] "مورد"
msgstr[1] "مورد"

msgid "In case you’ve forgotten, you are:"
msgstr "اگر فراموش کرده‌اید، شما این کاربر هستید:"

# ---- Django auth (django.contrib.auth) ----

msgid "Conflicting form data submitted. Please try again."
msgstr "داده‌های فرستاده‌شده با هم ناسازگارند. لطفاً دوباره تلاش کنید."

msgid "Password-based authentication was disabled."
msgstr "ورود با گذرواژه غیرفعال شد."

msgid "Set password: %s"
msgstr "تعیین گذرواژه: %s"

msgid "Reset password"
msgstr "تغییر گذرواژه"

msgid "Set password"
msgstr "تعیین گذرواژه"

msgid "Whether the user will be able to authenticate using a password or not. If disabled, they may still be able to authenticate using other backends, such as Single Sign-On or LDAP."
msgstr "آیا کاربر می‌تواند با گذرواژه وارد شود یا نه. اگر غیرفعال باشد، ممکن است هنوز از راه‌های دیگر (مثلاً کد پیامکی) وارد شود."

msgid "Password-based authentication"
msgstr "ورود با گذرواژه"

msgid "Enabled"
msgstr "فعال"

msgid "Disabled"
msgstr "غیرفعال"

msgid "Raw passwords are not stored, so there is no way to see the user’s password."
msgstr "گذرواژه‌ها به‌صورت خام ذخیره نمی‌شوند، پس راهی برای دیدن گذرواژهٔ کاربر وجود ندارد."

msgid "Enable password-based authentication for this user by setting a password."
msgstr "با تعیین گذرواژه، ورود با گذرواژه را برای این کاربر فعال کنید."

msgid "This password is too short. It must contain at least %d character."
msgid_plural "This password is too short. It must contain at least %d characters."
msgstr[0] "این گذرواژه خیلی کوتاه است. باید دست‌کم %d نویسه داشته باشد."
msgstr[1] "این گذرواژه خیلی کوتاه است. باید دست‌کم %d نویسه داشته باشد."

msgid "Enter a valid username. This value may contain only unaccented lowercase a-z and uppercase A-Z letters, numbers, and @/./+/-/_ characters."
msgstr "یک نام کاربری معتبر وارد کنید. فقط حروف انگلیسی (a-z و A-Z)، عدد و نویسه‌های @/./+/-/_ مجاز است."

# ---- Django forms and validators (django.core) ----

msgid "Enter a valid domain name."
msgstr "یک نام دامنهٔ معتبر وارد کنید."

msgid "Enter a valid %(protocol)s address."
msgstr "یک نشانی %(protocol)s معتبر وارد کنید."

msgid "IPv4 or IPv6"
msgstr "IPv4 یا IPv6"

msgid "Ensure this value is a multiple of step size %(limit_value)s."
msgstr "مقدار باید مضربی از %(limit_value)s باشد."

msgid "Ensure this value is a multiple of step size %(limit_value)s, starting from %(offset)s, e.g. %(offset)s, %(valid_value1)s, %(valid_value2)s, and so on."
msgstr "مقدار باید با گام %(limit_value)s و از %(offset)s شروع شود؛ مثلاً %(offset)s، %(valid_value1)s، %(valid_value2)s و به همین ترتیب."

msgid "Constraint “%(name)s” is violated."
msgstr "قید «%(name)s» رعایت نشده است."

msgid "%(model)s instance with %(field)s %(value)r is not a valid choice."
msgstr "%(model)s با %(field)s برابر %(value)r گزینهٔ معتبری نیست."

msgid "Please submit at most %(num)d form."
msgid_plural "Please submit at most %(num)d forms."
msgstr[0] "لطفاً حداکثر %(num)d فرم بفرستید."
msgstr[1] "لطفاً حداکثر %(num)d فرم بفرستید."

msgid "Please submit at least %(num)d form."
msgid_plural "Please submit at least %(num)d forms."
msgstr[0] "لطفاً دست‌کم %(num)d فرم بفرستید."
msgstr[1] "لطفاً دست‌کم %(num)d فرم بفرستید."

# ---- django-import-export ----

msgid "Import finished: {} new, {} updated, {} deleted and {} skipped {}."
msgstr "ورود اطلاعات تمام شد: {} جدید، {} به‌روزرسانی، {} حذف و {} بدون تغییر {}."

msgid "No valid data to import. Ensure your file has the correct headers or data for import."
msgstr "داده‌ای برای ورود پیدا نشد. مطمئن شوید سرستون‌ها و داده‌های فایل درست است."

msgid "export failed due to IllegalCharacterError"
msgstr "ساختن فایل خروجی ناموفق بود: داده‌ها نویسهٔ غیرمجاز دارند"

msgid "This exporter will export the following fields: "
msgstr "این ستون‌ها در فایل خروجی می‌آیند:"

msgid "Select all"
msgstr "انتخاب همه"

